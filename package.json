{
  "name": "threejs-typescript-arena-client",
  "version": "1.0.0",
  "description": "A basic threejs  arena client",
  "repository": {
    "type": "git",
    "url": "https://github.com/ApteroSAS/arena-client.git"
  },

  "keywords": [
    "Three.js",
    "TypeScript",
    "Webpack",
    "arena",
    "client",
    "template"
  ],
  "author": "EL AZOUZI CHAIMAE",
  "scripts": {
